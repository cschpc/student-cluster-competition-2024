#!/bin/bash

set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")"; pwd)
ICON_DIR=$(cd "${SCRIPT_DIR}/../.."; pwd)
#ICON_DIR=/projappl/project_2002078/jenkovaa/icon

MODULES='nvhpc/22.3' 
MPI_PATH='/appl/spack/v017/install-tree/gcc-8.5.0/nvhpc-22.3-237mkk/Linux_x86_64/22.3/comm_libs/mpi/bin/'

SPACK_ROOT=/scratch/project_2002078/jenkovaa/spack-instance/install_tree/nvhpc-22.3/

# NetCDF-C
NETCDF_ROOT="${SPACK_ROOT}/netcdf-c-4.8.1-3uqtls"
NETCDF_LIBS='-lnetcdf'

# NetCDF-Fortran
NETCDFF_ROOT="${SPACK_ROOT}/netcdf-fortran-4.5.3-ddivdz"
NETCDFF_LIBS='-lnetcdff'

# HDF5
HDF5_ROOT="${SPACK_ROOT}/hdf5-1.10.7-6npxvn"
HDF5_LIBS='-lnetcdf'

# ecCodes
ECCODES_ROOT="${SPACK_ROOT}/eccodes-2.24.2-xfs54h"
ECCODES_LIBS='-leccodes'


# BLAS/LAPACK
BLAS_LAPACK_ROOT="${SPACK_ROOT}/openblas-0.3.18-gyveyr"
BLAS_LAPACK_LIBS='-lopenblas'

# Libxml2
XML2_ROOT="${SPACK_ROOT}/libxml2-2.9.12-3mcjao"
XML2_LIBS='-lxml2'

# The rest of libraries required by CUDA will be provided by NVIDIA compiler:
STDCPP_LIBS='-lstdc++'


################################################################################

BUILD_ENV="module load .unsupported; module load ${MODULES};export \"PATH=${MPI_PATH}:\${PATH}\":export LD_LIBRARY_PATH=\"${NETCDF_ROOT}/lib:${NETCDFF_ROOT}/lib:${HDF5_ROOT}/lib:${ECCODES_ROOT}/lib64:${XML2_ROOT}/lib:${BLAS_LAPACK_ROOT}/lib:\${LD_LIBRARY_PATH}\";CC=mpicc; FC=mpif90;"

# We need some of the environment variables set by the modules now:
eval "$BUILD_ENV"

CC='mpicc'
CFLAGS='-g -O2'
CPPFLAGS="-I${NETCDF_ROOT}/include -I${HDF5_ROOT}/include -I${ECCODES_ROOT}/include -I${XML2_ROOT}/include/libxml2"

FC='mpif90'
FCFLAGS="-I${NETCDFF_ROOT}/include -g -O2 -Mrecursive -Mallocatable=03 -acc=verystrict -gpu=cc80 -D__USEG2G"

NVCC='nvcc'
NVCFLAGS='--std=c++11 -arch=sm_80 -g -O3'
CUDA_ROOT=/appl/spack/v017/install-tree/gcc-8.5.0/nvhpc-22.3-237mkk/Linux_x86_64/22.3/cuda/

LDFLAGS="-L${NETCDF_ROOT}/lib -L${NETCDFF_ROOT}/lib -L${HDF5_ROOT}/lib -L${ECCODES_ROOT}/lib64 -L${CUDA_ROOT}/lib64/ -L${BLAS_LAPACK_ROOT}/lib"
LIBS="-Wl,--as-needed ${XML2_LIBS} ${BLAS_LAPACK_LIBS} ${STDCPP_LIBS} ${NETCDFF_LIBS} ${NETCDF_LIBS} ${ECCODES_LIBS} ${HDF5_LIBS} -lcudart"


MPI_LAUNCH=srun

EXTRA_CONFIG_ARGS='--disable-loop-exchange --disable-art --disable-coupling --enable-gpu --enable-rte-rrtmgp'

# Speed up the configuration by disabling MPI checks:
EXTRA_CONFIG_ARGS+=' --disable-mpi-checks' 

################################################################################

"${ICON_DIR}/configure" \
BUILD_ENV="$BUILD_ENV" \
CC="$CC" \
CFLAGS="$CFLAGS" \
CPPFLAGS="$CPPFLAGS" \
FC="$FC" \
FCFLAGS="$FCFLAGS" \
LDFLAGS="$LDFLAGS" \
LIBS="$LIBS" \
MPI_LAUNCH="$MPI_LAUNCH" \
NVCC="$NVCC" \
NVCFLAGS="$NVCFLAGS" \
${EXTRA_CONFIG_ARGS} \
"$@"

for arg in "$@"; do
  case $arg in
    -help | --help | --hel | --he | -h | -help=r* | --help=r* | --hel=r* | --he=r* | -hr* | -help=s* | --help=s* | --hel=s* | --he=s* | -hs*)
      test -n "${EXTRA_CONFIG_ARGS}" && echo '' && echo "This wrapper script ('$0') calls the configure script with the following extra arguments, which might override the default values listed above: ${EXTRA_CONFIG_ARGS}"
      exit 0 ;;
  esac
done

# Copy runscript-related files when building out-of-source:
if test $(pwd) != $(cd "${ICON_DIR}"; pwd); then
  echo "Copying runscript input files from the source directory..."
  rsync -uavz ${ICON_DIR}/run . --exclude='*.in' --exclude='.*' --exclude='standard_*'
  ln -sf -t run/ ${ICON_DIR}/run/standard_*
  ln -sf set-up.info run/SETUP.config
  rsync -uavz ${ICON_DIR}/externals . --exclude='.git' --exclude='*.f90' --exclude='*.F90' --exclude='*.c' --exclude='*.h' --exclude='*.Po' --exclude='tests' --exclude='*.mod' --exclude='*.o'
  rsync -uavz ${ICON_DIR}/make_runscripts .
  ln -sf ${ICON_DIR}/data
  ln -sf ${ICON_DIR}/vertical_coord_tables
fi

