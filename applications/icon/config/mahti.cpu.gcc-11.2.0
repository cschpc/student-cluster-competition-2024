#!/bin/bash

set -eu
unset CDPATH

script_dir=$(cd "$(dirname "$0")"; pwd)
icon_dir=$(cd "${script_dir}/../.."; pwd)

modules='openblas/0.3.18-omp eccodes/2.24.2 hdf5/1.10.7-mpi netcdf-c/4.8.1 netcdf-fortran/4.5.3'

XML2_ROOT='/appl/spack/v017/install-tree/gcc-11.2.0/libxml2-2.9.12-govv6a/'
XML2_LIBS='-lxml2'

# BUILD_ENV needed for hdf5, netcdf, eccodes
BUILD_ENV="module load ${modules}; export LD_LIBRARY_PATH=\"{XML2_ROOT}/lib:\${LD_LIBRARY_PATH}\";"
eval "$BUILD_ENV"

ZLIB_LIBS='-lz'

HDF5F_INCLUDE="${HDF5_INSTALL_ROOT}/include"
HDF5_LIBS='-lhdf5_hl_fortran -lhdf5_fortran -lhdf5'

NETCDF_LIBS='-lnetcdf'

NETCDFF_INCLUDE="${NETCDF_FORTRAN_INSTALL_ROOT}/include"
NETCDFF_LIBS='-lnetcdff'

ECCODES_LIBS='-leccodes_f90 -leccodes'


BLAS_LAPACK_LIBS='-lopenblas'

################################################################################

CC='mpicc'
CPPFLAGS="-I${XML2_ROOT}/include/libxml2"
CFLAGS='-g'
ICON_CFLAGS='-O3'
ICON_BUNDLED_CFLAGS='-O2'

FC='mpif90'
FCFLAGS="-I${HDF5F_INCLUDE} -I${NETCDFF_INCLUDE} -fmodule-private -fimplicit-none -fmax-identifier-length=63 -Wall -Wcharacter-truncation -Wconversion -Wunderflow -Wunused-parameter -Wno-surprising -fall-intrinsics -g -fbacktrace -fstack-protector-all -finit-real=nan -finit-integer=-2147483648 -finit-character=127 -ffree-line-length-none -march=native -O2"
ICON_FCFLAGS='-std=f2008 -fallow-argument-mismatch'
ICON_BUNDLED_FCFLAGS='-std=f2008'
ICON_ECRAD_FCFLAGS='-fallow-invalid-boz -D__ECRAD_LITTLE_ENDIAN'
ICON_SCT_FCFLAGS=

LDFLAGS="-L${XML2_ROOT}/lib -L${HDF5_INSTALL_ROOT}/lib -L${NETCDF_C_INSTALL_ROOT}/lib -L${NETCDF_FORTRAN_INSTALL_ROOT}/lib -L${ECCODES_INSTALL_ROOT}/lib64 -L${OPENBLAS_INSTALL_ROOT}/lib"
LIBS="-Wl,--as-needed ${XML2_LIBS} ${ECCODES_LIBS} ${NETCDFF_LIBS} ${NETCDF_LIBS} ${HDF5_LIBS} ${ZLIB_LIBS} ${BLAS_LAPACK_LIBS}"

EXTRA_CONFIG_ARGS='--disable-mpi-checks --disable-coupling --enable-grib2 --enable-openmp'

################################################################################

"${icon_dir}/configure" \
BUILD_ENV="${BUILD_ENV}" \
CC="${CC}" \
CFLAGS="${CFLAGS}" \
CPPFLAGS="${CPPFLAGS}" \
FC="${FC}" \
FCFLAGS="${FCFLAGS}" \
ICON_BUNDLED_CFLAGS="${ICON_BUNDLED_CFLAGS}" \
ICON_BUNDLED_FCFLAGS="${ICON_BUNDLED_FCFLAGS}" \
ICON_CFLAGS="${ICON_CFLAGS}" \
ICON_ECRAD_FCFLAGS="${ICON_ECRAD_FCFLAGS}" \
ICON_FCFLAGS="${ICON_FCFLAGS}" \
ICON_SCT_FCFLAGS="${ICON_SCT_FCFLAGS}" \
LDFLAGS="${LDFLAGS}" \
LIBS="${LIBS}" \
${EXTRA_CONFIG_ARGS} \
"$@"

for arg in "$@"; do
  case $arg in
    -help | --help | --hel | --he | -h | -help=r* | --help=r* | --hel=r* | --he=r* | -hr* | -help=s* | --help=s* | --hel=s* | --he=s* | -hs*)
      test -n "${EXTRA_CONFIG_ARGS}" && echo '' && echo "This wrapper script ('$0') calls the configure script with the following extra arguments, which might override the default values listed above: ${EXTRA_CONFIG_ARGS}"
      exit 0 ;;
  esac
done

# Copy runscript-related files when building out-of-source:
if test $(pwd) != $(cd "${icon_dir}"; pwd); then
  echo "Copying runscript input files from the source directory..."
  rsync -uavz ${icon_dir}/run . --exclude='*.in' --exclude='.*' --exclude='standard_*'
  ln -sf -t run/ ${icon_dir}/run/standard_*
  rsync -uavz ${icon_dir}/externals . --exclude='.git' --exclude='*.f90' --exclude='*.F90' --exclude='*.c' --exclude='*.h' --exclude='*.Po' --exclude='tests' --exclude='*.mod' --exclude='*.o'
  rsync -uavz ${icon_dir}/make_runscripts .
  ln -sf ${icon_dir}/data
  ln -sf ${icon_dir}/vertical_coord_tables
fi

